    "type": "function",
    "z": "qa_stages_decy13_20261119",
    "name": "QA status from flow context",
    "func": "const s=flow.get('qa_state')||null;const last=flow.get('qa_last_rx')||0;const age=last?Date.now()-last:null;msg.headers={'Content-Type':'application/json','Cache-Control':'no-store'};msg.payload={online:age!==null&&age<=2500,ageMs:age,packets:flow.get('qa_packets')||0,sequence:flow.get('qa_sequence')||0,fieldCount:s?Object.keys(s).length:0,state:s};return msg;",
