  {
    "id": "qa-state-store",
    "type": "function",
    "z": "qa_stages_decy13_20261119",
    "name": "Store state in QA flow only",
    "func": "let d=msg.payload;\nif(Buffer.isBuffer(d))d=d.toString('utf8');\nif(typeof d==='string'){try{d=JSON.parse(d)}catch(e){node.warn('Invalid JSON QA');return null}}\nif(!d||typeof d!=='object'||Array.isArray(d)){node.warn('Non-object QA');return null}\nconst required=['power','vacuum','rf','magnet','interlocks','beam','exposureActive','emergency','stage','mode','lcd_line1','lcd_line2','lcd_line3','lcd_line4','pressure','beamEnergy','beamCurrent','targetCurrent','activeLedIdx','shootLedIdx','buzzerActive','logs'];\nconst missing=required.filter(x=>!Object.prototype.hasOwnProperty.call(d,x));\nif(missing.length||!Number.isInteger(d.stage)||d.stage<0||d.stage>7){node.warn('Invalid QA state: '+missing.join(','));return null}\nflow.set('qa_state',d);flow.set('qa_last_rx',Date.now());flow.set('qa_packets',(flow.get('qa_packets')||0)+1);flow.set('qa_sequence',(flow.get('qa_sequence')||0)+1);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 100,
    "wires": [
      []
    ]
  },
