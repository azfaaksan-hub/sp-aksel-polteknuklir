    {
        "id": "c9f60388d9206765",
        "type": "function",
        "z": "4545b853eee3bf43",
        "name": "Simpan State & Statistik Telemetri",
        "func": "// Simpan state terbaru dari decy13/rpi/state (MQTT) atau POST /api/sensor (fallback HTTP),\n// lalu hitung statistik telemetri (Hz, interval maksimum, paket rusak) untuk dashboard & QA.\nconst CONTRACT = [\n    \"power\", \"vacuum\", \"rf\", \"magnet\", \"interlocks\", \"beam\",\n    \"exposureActive\", \"emergency\", \"stage\", \"mode\",\n    \"lcd_line1\", \"lcd_line2\", \"lcd_line3\", \"lcd_line4\",\n    \"pressure\", \"beamEnergy\", \"beamCurrent\", \"targetCurrent\",\n    \"activeLedIdx\", \"shootLedIdx\", \"buzzerActive\", \"logs\"\n];\nconst now = Date.now();\n\nfunction on(v) {\n    if (v && typeof v === 'object') {\n        const vals = Array.isArray(v) ? v : Object.values(v);\n        return vals.length > 0 && vals.every(on);\n    }\n    return Boolean(v);\n}\nfunction num(v) {\n    return (typeof v === 'number' && isFinite(v)) ? v : null;\n}\n\nlet data = msg.payload;\nif (typeof Buffer !== 'undefined' && Buffer.isBuffer(data)) data = data.toString('utf8');\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) { data = null; }\n}\n\nconst meta = global.get('decy13_meta') || {};\nmeta.rx = meta.rx || [];\nmeta.packets = meta.packets || 0;\nmeta.bad = meta.bad || 0;\nmeta.exposureSeconds = meta.exposureSeconds || 0;\nmeta.lastHistMs = meta.lastHistMs || 0;\nmeta.hist = meta.hist || { pressure: [], target: [], beam: [] };\n\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n    meta.bad += 1;\n    global.set('decy13_meta', meta);\n    if (msg.res) {\n        msg.statusCode = 400;\n        msg.headers = { \"content-type\": \"application/json\" };\n        msg.payload = { status: \"error\", message: \"Payload bukan objek JSON\" };\n        return msg;\n    }\n    return null;\n}\n\n// Paket MQTT berisi state lengkap (ganti total). HTTP fallback boleh parsial (digabung).\nconst prev = global.get('decy13_state') || {};\nconst state = msg.res ? Object.assign({}, prev, data) : data;\n\n// Frekuensi & interval maksimum pada jendela 10 detik terakhir\nmeta.rx.push(now);\nconst cutoff = now - 10000;\nwhile (meta.rx.length && meta.rx[0] < cutoff) meta.rx.shift();\nlet hz = 0, maxGap = 0;\nif (meta.rx.length >= 2) {\n    const span = (meta.rx[meta.rx.length - 1] - meta.rx[0]) / 1000;\n    hz = span > 0 ? (meta.rx.length - 1) / span : 0;\n    for (let i = 1; i < meta.rx.length; i++) {\n        maxGap = Math.max(maxGap, meta.rx[i] - meta.rx[i - 1]);\n    }\n}\nmeta.hz = hz;\nmeta.maxGapMs = maxGap;\nmeta.packets += 1;\nmeta.missing = CONTRACT.filter(k => !(k in state));\n\n// Akumulasi waktu exposure (reset saat Power OFF)\nconst dtSec = meta.lastRx ? Math.min((now - meta.lastRx) / 1000, 2.0) : 0;\nmeta.lastRx = now;\nif (!on(state.power)) {\n    meta.exposureSeconds = 0;\n} else if (on(state.exposureActive)) {\n    meta.exposureSeconds += dtSec;\n}\n\n// Riwayat grafik: satu sampel per >= 500 ms, simpan 30 titik\nif (now - meta.lastHistMs >= 500) {\n    meta.lastHistMs = now;\n    const push = (arr, v) => { arr.push(v); while (arr.length > 30) arr.shift(); };\n    push(meta.hist.pressure, num(state.pressure));\n    push(meta.hist.target, num(state.targetCurrent));\n    push(meta.hist.beam, num(state.beamCurrent));\n}\n\nglobal.set('decy13_state', state);\nglobal.set('decy13_meta', meta);\n\n// Hanya jalur HTTP yang butuh balasan; paket MQTT tidak memiliki msg.res.\nif (msg.res) {\n    msg.statusCode = 200;\n    msg.headers = { \"content-type\": \"application/json\" };\n    msg.payload = { status: \"success\", message: \"State diperbarui via HTTP (fallback)\", missing_keys: meta.missing };\n    return msg;\n}\nreturn null;\n",
