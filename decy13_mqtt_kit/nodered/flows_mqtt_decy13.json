    {
        "id": "9b3406460c75f14d",
        "type": "template",
        "z": "4545b853eee3bf43",
        "name": "HTML Dashboard Siklotron",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "plain",
        "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Cyclotron Control Center - Dashboard Cadangan</title>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font-family: Arial, Helvetica, sans-serif;\n    background: #111;\n    color: #e8e8e8;\n  }\n  .topbar {\n    height: 50px;\n    background: #008b8b;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 18px;\n    font-weight: bold;\n    letter-spacing: .2px;\n  }\n  .brand { display: flex; align-items: center; gap: 12px; }\n  .hamburger { font-size: 22px; }\n  .link-badge {\n    padding: 4px 12px;\n    border-radius: 12px;\n    font-size: 12px;\n    background: #555;\n  }\n  .link-badge.online { background: #10b936; }\n  .link-badge.offline { background: #ff1010; }\n  .offline-banner {\n    display: none;\n    background: #b71c1c;\n    color: #fff;\n    text-align: center;\n    padding: 8px;\n    font-size: 13px;\n    font-weight: bold;\n  }\n  .container {\n    display: grid;\n    grid-template-columns: 255px 1fr;\n    gap: 8px;\n    padding: 8px;\n    min-height: calc(100vh - 50px);\n    background: #161616;\n  }\n  .panel, .card {\n    background: #2a2a2a;\n    border: 1px solid #101010;\n    box-shadow: inset 0 0 0 1px #363636;\n  }\n  .panel-title, .card-title {\n    background: #202020;\n    padding: 9px 10px;\n    font-size: 14px;\n    font-weight: bold;\n    border-bottom: 1px solid #111;\n  }\n  .panel-body { padding: 10px; }\n  .status-row {\n    display: grid;\n    grid-template-columns: 1fr 48px 74px;\n    align-items: center;\n    gap: 8px;\n    padding: 7px 0;\n    border-bottom: 1px solid rgba(255,255,255,.05);\n    font-size: 13px;\n  }\n  .toggle {\n    width: 44px;\n    height: 20px;\n    border-radius: 20px;\n    background: #575757;\n    position: relative;\n  }\n  .toggle::after {\n    content: \"\";\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    position: absolute;\n    top: 1px;\n    left: 1px;\n    background: #c8c8c8;\n    transition: .2s;\n  }\n  .toggle.on { background: #10b936; }\n  .toggle.on::after { left: 25px; background: #eaffea; }\n  .clickable { cursor: pointer; }\n  .clickable:hover { filter: brightness(1.3); }\n  .small-label { color: #d7d7d7; }\n  .btn {\n    width: 100%;\n    border: none;\n    color: white;\n    padding: 15px 8px;\n    margin-bottom: 8px;\n    font-size: 14px;\n    font-weight: bold;\n    cursor: pointer;\n    border-radius: 2px;\n    transition: transform .08s, filter .15s;\n  }\n  .btn:hover { filter: brightness(1.12); }\n  .btn:active { transform: scale(.98); }\n  .init { background: #1565c0; }\n  .start { background: #00a817; }\n  .shoot { background: #d84315; box-shadow: 0 0 0 1px #ff8833 inset; }\n  .emergency { background: #ff1010; padding: 22px 8px; box-shadow: 0 0 0 2px #ff6969 inset; }\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(180px, 1fr));\n    grid-auto-rows: minmax(178px, auto);\n    gap: 8px;\n  }\n  .card { position: relative; overflow: hidden; }\n  .card-body { padding: 10px; }\n  .big { font-size: 26px; text-align: center; margin: 4px 0 6px; }\n  .unit { font-size: 14px; color: #cfcfcf; }\n  .metric-note { text-align: center; color: #cfcfcf; font-size: 12px; margin-top: 2px; }\n  .gauge-wrap { display: flex; align-items: center; justify-content: center; height: 112px; }\n  .gauge {\n    --p: 0;\n    --c1: #27d447;\n    --c2: #ffcf23;\n    --c3: #ef3f2d;\n    width: 112px;\n    height: 112px;\n    border-radius: 50%;\n    background: conic-gradient(var(--c1) 0deg, var(--c2) calc(var(--p) * 1.8deg), var(--c3) calc(var(--p) * 2.2deg), #595959 250deg 360deg);\n    display: grid;\n    place-items: center;\n    transform: rotate(-125deg);\n  }\n  .gauge::before {\n    content: \"\";\n    width: 76px;\n    height: 76px;\n    border-radius: 50%;\n    background: #333;\n    position: absolute;\n  }\n  .gauge-value {\n    position: relative;\n    text-align: center;\n    transform: rotate(125deg);\n    font-size: 18px;\n    line-height: 1.2;\n  }\n  .wave {\n    height: 82px;\n    width: 100%;\n    background: repeating-linear-gradient(90deg, rgba(255,150,60,.95) 0 3px, transparent 3px 9px);\n    clip-path: polygon(0 52%,4% 20%,8% 80%,12% 20%,16% 80%,20% 20%,24% 80%,28% 20%,32% 80%,36% 20%,40% 80%,44% 20%,48% 80%,52% 20%,56% 80%,60% 20%,64% 80%,68% 20%,72% 80%,76% 20%,80% 80%,84% 20%,88% 80%,92% 20%,96% 80%,100% 52%);\n    opacity: .9;\n    margin-top: 14px;\n  }\n  .wave.idle { opacity: .15; }\n  canvas { width: 100%; height: 95px; background: #253338; border: 1px solid #151515; display: block; }\n  .beam-profile {\n    width: 116px;\n    height: 116px;\n    margin: 5px auto 0;\n    background: radial-gradient(circle, #fff 0 5%, #ffff00 7% 12%, #ff5500 16% 24%, #006dff 36% 50%, #00114f 64%, #000 100%);\n    border: 1px solid #223;\n    transition: opacity .3s;\n  }\n  .wide { grid-column: span 2; }\n  .full { grid-column: span 4; }\n  .logs {\n    height: 125px;\n    background: #171717;\n    overflow-y: auto;\n    padding: 8px;\n    font-size: 12px;\n    line-height: 1.35;\n    white-space: pre-wrap;\n    border: 1px solid #333;\n  }\n  .lcd {\n    height: 96px;\n    background: #0b1d12;\n    color: #5dff8a;\n    font-family: Consolas, \"Courier New\", monospace;\n    font-size: 13px;\n    line-height: 1.5;\n    padding: 8px 10px;\n    border: 1px solid #1d4d2c;\n    white-space: pre;\n    overflow: hidden;\n  }\n  .footer-status {\n    margin-top: 8px;\n    padding: 9px 10px;\n    font-size: 13px;\n    background: #1f1f1f;\n    border-left: 4px solid #00a817;\n  }\n  .footer-status.bad { border-left-color: #ff1010; }\n  .indicator-grid {\n    display: grid;\n    grid-template-columns: repeat(8, minmax(100px, 1fr));\n    gap: 8px;\n    align-items: stretch;\n  }\n  .indicator {\n    background: #1c1c1c;\n    border: 1px solid #3e3e3e;\n    border-left: 5px solid #777;\n    padding: 10px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    min-height: 92px;\n  }\n  .indicator .label {\n    font-size: 12px;\n    color: #cfcfcf;\n    margin-bottom: 7px;\n    letter-spacing: .3px;\n  }\n  .indicator .value {\n    font-size: 16px;\n    font-weight: bold;\n    word-break: break-word;\n  }\n  .indicator.ok { border-left-color: #10b936; }\n  .indicator.warn { border-left-color: #ffd600; }\n  .indicator.bad { border-left-color: #ff1010; }\n  .indicator.neutral { border-left-color: #38c4df; }\n  .exposure-time {\n    font-family: Consolas, \"Courier New\", monospace;\n    font-size: 32px;\n    text-align: center;\n    margin-top: 24px;\n  }\n  @media (max-width: 1400px) {\n    .indicator-grid { grid-template-columns: repeat(4, minmax(100px, 1fr)); }\n  }\n  @media (max-width: 900px) {\n    .container { grid-template-columns: 1fr; }\n    .grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); }\n    .full { grid-column: span 2; }\n    .indicator-grid { grid-template-columns: repeat(2, minmax(100px, 1fr)); }\n  }\n</style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"brand\"><span class=\"hamburger\">&#9776;</span><span>CYCLOTRON CONTROL CENTER - DASHBOARD CADANGAN</span></div>\n    <div><span id=\"linkBadge\" class=\"link-badge\">Telemetri: menunggu</span></div>\n  </div>\n  <div class=\"offline-banner\" id=\"offlineBanner\">TELEMETRI TERPUTUS: tidak ada paket dari RPi (decy13/rpi/state). Data di layar adalah data terakhir yang diterima.</div>\n\n  <div class=\"container\">\n    <div class=\"sidebar\">\n      <div class=\"panel\">\n        <div class=\"panel-title\">SYSTEM STATUS</div>\n        <div class=\"panel-body\">\n          <div class=\"status-row\"><span>&#9211; Power</span><span id=\"pwr\" class=\"toggle clickable\" onclick=\"sendCmd('TOGGLE_POWER')\"></span><span id=\"pwrText\" class=\"small-label\">Off</span></div>\n          <div class=\"status-row\"><span>&#9832; Vacuum</span><span id=\"vac\" class=\"toggle clickable\" onclick=\"sendCmd('TOGGLE_VACUUM')\"></span><span id=\"vacText\" class=\"small-label\">Off</span></div>\n          <div class=\"status-row\"><span>&#9889; RF System</span><span id=\"rf\" class=\"toggle\"></span><span id=\"rfText\" class=\"small-label\">Idle</span></div>\n          <div class=\"status-row\"><span>&#129522; Magnet</span><span id=\"mag\" class=\"toggle\"></span><span id=\"magText\" class=\"small-label\">Off</span></div>\n          <div class=\"status-row\"><span>&#10003; Interlocks</span><span id=\"int\" class=\"toggle clickable\" onclick=\"sendCmd('TOGGLE_INTERLOCK')\"></span><span id=\"intText\" class=\"small-label\">Not Set</span></div>\n          <div class=\"status-row\"><span>&#9762; Beam</span><span id=\"beam\" class=\"toggle\"></span><span id=\"beamText\" class=\"small-label\">Off</span></div>\n        </div>\n      </div>\n\n      <div class=\"panel\" style=\"margin-top:8px;\">\n        <div class=\"panel-title\">OPERATION CONTROL</div>\n        <div class=\"panel-body\">\n          <button class=\"btn init\" onclick=\"sendCmd('AUTO_INIT')\">[AUTO INIT]</button>\n          <button class=\"btn start\" onclick=\"sendCmd('START_BEAM')\">[START BEAM]</button>\n          <button class=\"btn shoot\" onclick=\"sendCmd('SHOOT')\">[SHOOT EXPOSURE]</button>\n          <button class=\"btn emergency\" onclick=\"sendCmd('EMERGENCY_STOP')\">[EMERGENCY STOP]</button>\n        </div>\n      </div>\n    </div>\n\n    <div>\n      <div class=\"grid\">\n        <div class=\"card full\">\n          <div class=\"card-title\">STATUS INDIKATOR OPERASI</div>\n          <div class=\"card-body\">\n            <div class=\"indicator-grid\">\n              <div id=\"indMode\" class=\"indicator neutral\"><div class=\"label\">MODE OPERASI</div><div id=\"indModeVal\" class=\"value\">-</div></div>\n              <div id=\"indStage\" class=\"indicator neutral\"><div class=\"label\">TAHAP (STAGE)</div><div id=\"indStageVal\" class=\"value\">-</div></div>\n              <div id=\"indReady\" class=\"indicator warn\"><div class=\"label\">BEAM READY</div><div id=\"indReadyVal\" class=\"value\">Not Ready</div></div>\n              <div id=\"indBeam\" class=\"indicator neutral\"><div class=\"label\">STATUS BERKAS</div><div id=\"indBeamVal\" class=\"value\">Off</div></div>\n              <div id=\"indExposure\" class=\"indicator neutral\"><div class=\"label\">EXPOSURE</div><div id=\"indExposureVal\" class=\"value\">Inactive</div></div>\n              <div id=\"indSafety\" class=\"indicator warn\"><div class=\"label\">SAFETY INTERLOCK</div><div id=\"indSafetyVal\" class=\"value\">-</div></div>\n              <div id=\"indEnergy\" class=\"indicator neutral\"><div class=\"label\">ENERGI PUNCAK</div><div id=\"indEnergyVal\" class=\"value\">0.0 MeV</div></div>\n              <div id=\"indLink\" class=\"indicator warn\"><div class=\"label\">TELEMETRI RPi</div><div id=\"indLinkVal\" class=\"value\">Menunggu</div></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">MAGNET SYSTEM</div>\n          <div class=\"card-body\">\n            <div style=\"text-align:center; font-size:13px;\">Bending Magnet Current</div>\n            <div class=\"big\"><span id=\"magnetCurrent\">--</span> <span class=\"unit\">A</span></div>\n            <div class=\"gauge-wrap\"><div class=\"gauge\" id=\"gMag\"><div class=\"gauge-value\"><span id=\"gMagVal\">--</span><br><span class=\"unit\">A</span></div></div></div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">RF SYSTEM</div>\n          <div class=\"card-body\">\n            <div style=\"text-align:center; font-size:13px;\">Frequency</div>\n            <div class=\"big\"><span id=\"freq\">--</span> <span class=\"unit\">MHz</span></div>\n            <div class=\"wave idle\" id=\"wave\"></div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">RF POWER</div>\n          <div class=\"card-body\">\n            <div class=\"gauge-wrap\"><div class=\"gauge\" id=\"gRf\"><div class=\"gauge-value\"><span id=\"rfPower\">--</span><br><span class=\"unit\">kW</span></div></div></div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">VACUUM SYSTEM</div>\n          <div class=\"card-body\">\n            <div style=\"text-align:center; font-size:13px;\">Beam Line Pressure</div>\n            <div class=\"big\"><span id=\"pressure\">--</span> <span class=\"unit\">mbar</span></div>\n            <canvas id=\"pressureChart\"></canvas>\n            <div class=\"metric-note\">Grafik skala log10(mbar)</div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">MAGNET POWER</div>\n          <div class=\"card-body\">\n            <div class=\"big\"><span id=\"magnetPower\">--</span> <span class=\"unit\">kW</span></div>\n            <div class=\"gauge-wrap\"><div class=\"gauge\" id=\"gMP\"><div class=\"gauge-value\"><span id=\"gMPVal\">--</span><br><span class=\"unit\">kW</span></div></div></div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">ARUS BERKAS / BEAM CURRENT</div>\n          <div class=\"card-body\">\n            <div class=\"gauge-wrap\"><div class=\"gauge\" id=\"gBeamCurrent\"><div class=\"gauge-value\"><span id=\"beamCurrent\">0</span><br><span class=\"unit\">&micro;A</span></div></div></div>\n            <div class=\"metric-note\">Arus berkas aktual saat iradiasi</div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">BEAM ENERGY</div>\n          <div class=\"card-body\">\n            <div class=\"gauge-wrap\"><div class=\"gauge\" id=\"gEnergy\"><div class=\"gauge-value\"><span id=\"beamEnergy\">0</span><br><span class=\"unit\">MeV</span></div></div></div>\n            <div class=\"metric-note\">Maksimum energi puncak: <b>13 MeV</b></div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">WAKTU EXPOSURE</div>\n          <div class=\"card-body\">\n            <div class=\"exposure-time\" id=\"exposureTime\">00:00:00</div>\n            <div class=\"metric-note\">Akumulasi waktu exposure aktif (reset saat Power OFF)</div>\n          </div>\n        </div>\n\n        <div class=\"card wide\">\n          <div class=\"card-title\">BEAM DIAGNOSTICS</div>\n          <div class=\"card-body\">\n            <div style=\"font-size:13px; margin-bottom:4px;\">Target Current: <b><span id=\"targetCurrent\">0</span> &micro;A</b></div>\n            <canvas id=\"targetChart\"></canvas>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">BEAM PROFILE</div>\n          <div class=\"card-body\"><div class=\"beam-profile\" id=\"beamProfile\"></div></div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">BEAM CURRENT TREND</div>\n          <div class=\"card-body\">\n            <canvas id=\"beamCurrentChart\"></canvas>\n            <div class=\"metric-note\">Trend arus berkas &micro;A</div>\n          </div>\n        </div>\n\n        <div class=\"card wide\">\n          <div class=\"card-title\">ALERTS &amp; LOGS (DARI DAEMON RPi)</div>\n          <div class=\"card-body\"><div class=\"logs\" id=\"logs\"></div></div>\n        </div>\n\n        <div class=\"card wide\">\n          <div class=\"card-title\">LCD &amp; LED (SALINAN TELEMETRI)</div>\n          <div class=\"card-body\">\n            <div class=\"lcd\" id=\"lcd\"></div>\n            <div class=\"metric-note\">LED spiral #<b id=\"ledSpiral\">-</b> | LED shoot #<b id=\"ledShoot\">-</b> | Buzzer: <b id=\"buzzer\">-</b></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer-status\" id=\"footerStatus\">Status: menunggu data...</div>\n    </div>\n  </div>\n\n<script>\n  let cmdNote = '';\n\n  function fmt(v, digits) {\n    return (typeof v === 'number' && isFinite(v)) ? v.toFixed(digits) : '--';\n  }\n\n  function setToggle(id, value, textId, textOn, textOff) {\n    document.getElementById(id).classList.toggle('on', !!value);\n    document.getElementById(textId).textContent = value ? textOn : textOff;\n  }\n\n  function setGauge(id, percent) {\n    const p = (typeof percent === 'number' && isFinite(percent)) ? percent : 0;\n    document.getElementById(id).style.setProperty('--p', Math.max(0, Math.min(100, p)));\n  }\n\n  function formatDuration(seconds) {\n    seconds = Math.max(0, Math.floor(Number(seconds) || 0));\n    const h = String(Math.floor(seconds / 3600)).padStart(2, '0');\n    const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');\n    const s = String(seconds % 60).padStart(2, '0');\n    return h + ':' + m + ':' + s;\n  }\n\n  function setIndicator(id, valueId, text, stateClass) {\n    document.getElementById(id).className = 'indicator ' + stateClass;\n    document.getElementById(valueId).textContent = text;\n  }\n\n  function drawLine(canvasId, values) {\n    const canvas = document.getElementById(canvasId);\n    const ctx = canvas.getContext('2d');\n    const w = canvas.width = canvas.offsetWidth;\n    const h = canvas.height = canvas.offsetHeight;\n    ctx.clearRect(0, 0, w, h);\n    ctx.strokeStyle = '#234d5a';\n    ctx.lineWidth = 1;\n    for (let i = 0; i < 5; i++) {\n      const y = (h / 4) * i;\n      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();\n    }\n    if (!values || values.length < 2) return;\n    const max = Math.max.apply(null, values);\n    const min = Math.min.apply(null, values);\n    const span = (max - min) || 1;\n    ctx.strokeStyle = '#38c4df';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    values.forEach(function (v, i) {\n      const x = (w / (values.length - 1)) * i;\n      const y = h - ((v - min) / span) * (h - 12) - 6;\n      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n    });\n    ctx.stroke();\n  }\n\n  function renderLink(link, waiting) {\n    const badge = document.getElementById('linkBadge');\n    const banner = document.getElementById('offlineBanner');\n    const foot = document.getElementById('footerStatus');\n    if (waiting) {\n      badge.className = 'link-badge';\n      badge.textContent = 'Telemetri: menunggu paket pertama';\n      banner.style.display = 'none';\n      setIndicator('indLink', 'indLinkVal', 'Menunggu', 'warn');\n      foot.className = 'footer-status bad';\n      return;\n    }\n    if (link.online) {\n      const txt = 'ONLINE ' + link.hz.toFixed(1) + ' Hz';\n      badge.className = 'link-badge online';\n      badge.textContent = 'Telemetri: ' + txt;\n      banner.style.display = 'none';\n      const slow = link.hz < 4.0 || link.maxGapMs > 1000;\n      setIndicator('indLink', 'indLinkVal', txt, slow ? 'warn' : 'ok');\n      foot.className = 'footer-status';\n    } else {\n      badge.className = 'link-badge offline';\n      badge.textContent = 'Telemetri: OFFLINE';\n      banner.style.display = 'block';\n      setIndicator('indLink', 'indLinkVal', 'OFFLINE', 'bad');\n      foot.className = 'footer-status bad';\n    }\n  }\n\n  async function loadStatus() {\n    try {\n      const res = await fetch('/api/status');\n      const data = await res.json();\n\n      if (data.waiting) {\n        renderLink(data.link, true);\n        document.getElementById('footerStatus').textContent = 'Status: menunggu paket pertama dari decy13/rpi/state ...';\n        return;\n      }\n\n      const st = data.status;\n      const mt = data.metrics;\n      renderLink(data.link, false);\n\n      const beamReady = st.power && st.vacuum && st.interlocks && !st.emergency;\n      setToggle('pwr', st.power, 'pwrText', 'On', 'Off');\n      setToggle('vac', st.vacuum, 'vacText', 'On', 'Off');\n      setToggle('rf', st.rf, 'rfText', 'Active', 'Idle');\n      setToggle('mag', st.magnet, 'magText', 'Stable', 'Off');\n      setToggle('int', st.interlocks, 'intText', 'Set', 'Not Set');\n      setToggle('beam', st.beam, 'beamText', 'On', 'Off');\n\n      setIndicator('indMode', 'indModeVal', data.mode, st.emergency ? 'bad' : (st.beam ? 'ok' : 'neutral'));\n      setIndicator('indStage', 'indStageVal', 'Stage ' + data.stage, 'neutral');\n      setIndicator('indReady', 'indReadyVal', beamReady ? 'Ready' : 'Not Ready', beamReady ? 'ok' : 'warn');\n      setIndicator('indBeam', 'indBeamVal', st.beam ? 'Beam On' : 'Beam Off', st.beam ? 'ok' : 'neutral');\n      setIndicator('indExposure', 'indExposureVal', st.exposureActive ? 'Active' : 'Inactive', st.exposureActive ? 'ok' : 'neutral');\n      setIndicator('indSafety', 'indSafetyVal', st.emergency ? 'Emergency' : (st.interlocks ? 'Normal' : 'Interlock Off'), st.emergency ? 'bad' : (st.interlocks ? 'ok' : 'warn'));\n      setIndicator('indEnergy', 'indEnergyVal', fmt(mt.beamEnergy, 1) + ' MeV', 'neutral');\n\n      // Metrik opsional: hanya tampil bila daemon mengirimnya (di luar 22 field kontrak).\n      document.getElementById('magnetCurrent').textContent = fmt(mt.magnetCurrent, 1);\n      document.getElementById('gMagVal').textContent = fmt(mt.magnetCurrent, 0);\n      document.getElementById('freq').textContent = fmt(mt.frequency, 2);\n      document.getElementById('rfPower').textContent = fmt(mt.rfPower, 1);\n      document.getElementById('magnetPower').textContent = fmt(mt.magnetPower, 1);\n      document.getElementById('gMPVal').textContent = fmt(mt.magnetPower, 1);\n      document.getElementById('wave').className = 'wave' + (st.rf ? '' : ' idle');\n\n      // Metrik kontrak\n      document.getElementById('pressure').textContent = (typeof mt.pressure === 'number' && isFinite(mt.pressure)) ? mt.pressure.toExponential(1) : '--';\n      document.getElementById('targetCurrent').textContent = fmt(mt.targetCurrent, 1);\n      document.getElementById('beamCurrent').textContent = fmt(mt.beamCurrent, 1);\n      document.getElementById('beamEnergy').textContent = fmt(mt.beamEnergy, 1);\n      document.getElementById('exposureTime').textContent = formatDuration(mt.exposureSeconds);\n      document.getElementById('beamProfile').style.opacity = st.beam ? 1 : 0.25;\n\n      document.getElementById('logs').textContent = data.logs.join('\\n');\n      document.getElementById('lcd').textContent = data.lcd.join('\\n');\n      document.getElementById('ledSpiral').textContent = data.led.spiral;\n      document.getElementById('ledShoot').textContent = data.led.shoot;\n      document.getElementById('buzzer').textContent = st.buzzerActive ? 'AKTIF' : 'Off';\n\n      let foot = 'Status: ' + data.mode + ' | Stage ' + data.stage +\n        ' | Arus berkas: ' + fmt(mt.beamCurrent, 1) + ' \\u00b5A | Exposure: ' + formatDuration(mt.exposureSeconds) +\n        ' | Update terakhir: ' + data.time;\n      if (data.link.missing.length) foot += ' | PERINGATAN kontrak: field hilang ' + data.link.missing.join(', ');\n      if (cmdNote) foot += ' | ' + cmdNote;\n      document.getElementById('footerStatus').textContent = foot;\n\n      setGauge('gMag', mt.magnetCurrent / 20);\n      setGauge('gRf', mt.rfPower / 3);\n      setGauge('gMP', mt.magnetPower);\n      setGauge('gBeamCurrent', mt.beamCurrent / 0.15);\n      setGauge('gEnergy', (mt.beamEnergy / 13) * 100);\n      drawLine('pressureChart', data.history.pressureLog);\n      drawLine('targetChart', data.history.target);\n      drawLine('beamCurrentChart', data.history.beamCurrent);\n    } catch (e) {\n      document.getElementById('footerStatus').textContent = 'Status: koneksi ke Node-RED gagal';\n      document.getElementById('footerStatus').className = 'footer-status bad';\n    }\n  }\n\n  async function sendCmd(cmd) {\n    try {\n      const res = await fetch('/api/control', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify({cmd: cmd})\n      });\n      const j = await res.json();\n      if (res.ok) {\n        cmdNote = 'Perintah ' + cmd + ' terkirim' + (j.telemetryOnline ? '' : ' (telemetri OFFLINE, efek tidak terverifikasi)');\n      } else {\n        cmdNote = 'Perintah ditolak: ' + (j.error || res.status);\n      }\n    } catch (e) {\n      cmdNote = 'Gagal mengirim ' + cmd + ' ke Node-RED';\n    }\n  }\n\n  async function loadStatusLoop() {\n    await loadStatus();\n    setTimeout(loadStatusLoop, 250);\n  }\n  loadStatusLoop();\n</script>\n</body>\n</html>\n",
