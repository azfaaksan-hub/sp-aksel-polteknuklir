    {
        "id": "535d75bf57449b3b",
        "type": "function",
        "z": "4545b853eee3bf43",
        "name": "Validasi & Publish Perintah",
        "func": "// Validasi perintah dari dashboard, lalu teruskan ke daemon RPi lewat MQTT (decy13/hmi/cmd).\n// Dashboard cadangan TIDAK menyentuh GPIO: relay (GPIO 21), buzzer (GPIO 17), LED WS2812B (GPIO 18),\n// dan E-Stop (GPIO 22) dikendalikan modul daemon RPi. Dua pengendali = konflik.\nconst ALLOWED = [\n    'TOGGLE_POWER', 'TOGGLE_VACUUM', 'TOGGLE_INTERLOCK', 'AUTO_INIT',\n    'START_BEAM', 'SHOOT', 'EMERGENCY_STOP', 'SET_PARAMS'\n];\nconst PARAM_KEYS = ['magnet_a', 'rf_mhz', 'rf_kv', 'beam_ua'];\n\nlet body = msg.payload || (msg.req && msg.req.body) || {};\nif (typeof body === 'string') {\n    try { body = JSON.parse(body); } catch (e) { body = {}; }\n}\nconst cmd = String(body.cmd || '').toUpperCase();\n\nmsg.headers = { \"content-type\": \"application/json\" };\n\nif (ALLOWED.indexOf(cmd) === -1) {\n    msg.statusCode = 400;\n    msg.payload = { ok: false, error: 'Perintah tidak dikenal: ' + cmd, allowed: ALLOWED };\n    return [msg, null];\n}\n\nconst out = { cmd: cmd };\nif (cmd === 'SET_PARAMS') {\n    PARAM_KEYS.forEach(k => {\n        if (body[k] !== undefined && body[k] !== null && body[k] !== '' && isFinite(Number(body[k]))) {\n            out[k] = Number(body[k]);\n        }\n    });\n}\n\nconst now = Date.now();\nconst meta = global.get('decy13_meta') || {};\nconst online = !!(meta.lastRx && (now - meta.lastRx) <= 2000);\nglobal.set('decy13_lastcmd', {\n    cmd: cmd,\n    time: new Date().toLocaleTimeString('id-ID', { hour12: false }),\n    telemetryOnline: online\n});\n\nmsg.statusCode = 200;\nmsg.payload = { ok: true, command: cmd, published: true, telemetryOnline: online };\n\n// Keluaran 2: pesan baru (tanpa req/res) menuju node mqtt out. Tidak boleh retained.\nreturn [msg, { payload: out }];\n",
