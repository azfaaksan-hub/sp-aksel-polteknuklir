    {
        "id": "dcd1ca73c11dc214",
        "type": "function",
        "z": "4545b853eee3bf43",
        "name": "Bangun Status dari State MQTT",
        "func": "// Bangun payload /api/status dari state NYATA yang diterima lewat MQTT (tanpa simulasi fisika).\nconst STALE_MS = 2000;   // telemetri dianggap putus bila tidak ada paket > 2 detik (normalnya tiap 200 ms)\nconst now = Date.now();\nconst s = global.get('decy13_state');\nconst m = global.get('decy13_meta') || {};\n\nfunction on(v) {\n    if (v && typeof v === 'object') {\n        const vals = Array.isArray(v) ? v : Object.values(v);\n        return vals.length > 0 && vals.every(on);\n    }\n    return Boolean(v);\n}\nfunction num(v, d) {\n    if (v === null || v === undefined || v === '') return d;\n    const n = Number(v);\n    return isFinite(n) ? n : d;\n}\n\nconst ageMs = m.lastRx ? now - m.lastRx : null;\nconst link = {\n    online: ageMs !== null && ageMs <= STALE_MS,\n    ageMs: ageMs,\n    hz: m.hz || 0,\n    maxGapMs: m.maxGapMs || 0,\n    packets: m.packets || 0,\n    bad: m.bad || 0,\n    missing: m.missing || []\n};\n\nmsg.headers = { \"content-type\": \"application/json\" };\nmsg.statusCode = 200;\n\nif (!s) {\n    msg.payload = { waiting: true, link: link, time: new Date().toLocaleTimeString('id-ID', { hour12: false }) };\n    return msg;\n}\n\nconst hist = m.hist || { pressure: [], target: [], beam: [] };\nconst logs = Array.isArray(s.logs) ? s.logs.slice(0, 12).map(String) : [];\nconst lcd = [s.lcd_line1, s.lcd_line2, s.lcd_line3, s.lcd_line4].map(x => (x === undefined || x === null) ? '' : String(x));\n\nmsg.payload = {\n    time: new Date().toLocaleTimeString('id-ID', { hour12: false }),\n    link: link,\n    stage: (s.stage === undefined || s.stage === null) ? '-' : s.stage,\n    mode: (s.mode === undefined || s.mode === null) ? '-' : String(s.mode),\n    status: {\n        power: on(s.power),\n        vacuum: on(s.vacuum),\n        rf: on(s.rf),\n        magnet: on(s.magnet),\n        interlocks: on(s.interlocks),\n        beam: on(s.beam),\n        emergency: on(s.emergency),\n        exposureActive: on(s.exposureActive),\n        buzzerActive: on(s.buzzerActive)\n    },\n    metrics: {\n        // 22 field kontrak\n        pressure: num(s.pressure, null),\n        beamEnergy: num(s.beamEnergy, 0),\n        beamCurrent: num(s.beamCurrent, 0),\n        targetCurrent: num(s.targetCurrent, 0),\n        exposureSeconds: m.exposureSeconds || 0,\n        // Opsional: di luar kontrak, null bila daemon tidak mengirim (dashboard menampilkan \"--\")\n        magnetCurrent: num(s.magnetCurrent, null),\n        frequency: num(s.frequency, null),\n        rfPower: num(s.rfPower, null),\n        magnetPower: num(s.magnetPower, null)\n    },\n    led: {\n        spiral: (s.activeLedIdx === undefined || s.activeLedIdx === null) ? '-' : s.activeLedIdx,\n        shoot: (s.shootLedIdx === undefined || s.shootLedIdx === null) ? '-' : s.shootLedIdx\n    },\n    lcd: lcd,\n    history: {\n        // Tekanan memakai log10 agar penurunan 1e3 -> 1e-7 mbar terlihat jelas pada grafik\n        pressureLog: (hist.pressure || []).filter(v => v !== null && v > 0).map(v => Math.log10(v)),\n        target: (hist.target || []).filter(v => v !== null),\n        beamCurrent: (hist.beam || []).filter(v => v !== null)\n    },\n    logs: logs,\n    lastCmd: global.get('decy13_lastcmd') || null\n};\nreturn msg;\n",
